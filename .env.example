# Browser-visible Supabase project configuration (the anon key is not a private credential).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional read-only IC mapping endpoint; leave unset to use the configured Google Sheet GID.
# For a protected sheet, point this at a secured read-only backend endpoint.
VITE_IC_MAPPING_URL=

# Configure the actual deployed Apps Script /exec URL as a Supabase Edge Function secret,
# never as a VITE_ variable or committed URL:
# supabase secrets set GOOGLE_SCRIPT_URL=<deployed-exec-url>
